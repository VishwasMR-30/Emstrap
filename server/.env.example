# Copy this file to ".env" and fill in the values.
PORT=5000
# Frontend address(es) allowed to call this API (comma separated)
CLIENT_ORIGIN=http://localhost:5173
# Pick a password to view saved data at /api/admin/contacts?key=YOUR_KEY
ADMIN_KEY=change-me
# Optional: MongoDB Atlas connection string. Leave empty to use a local file.
MONGODB_URI=
